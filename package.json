{
  "name": "mindshop",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:client -- --watch & wrangler dev",
    "dev:node": "npm run build:client -- --watch & tsx watch src/server/node.ts",
    "start": "tsx src/server/node.ts",
    "migrate:pg": "drizzle-kit generate --config drizzle.pg.config.ts",
    "dev:client": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json --noEmit",
    "deploy": "npm run build && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply mindshop --local",
    "db:migrate:remote": "wrangler d1 migrations apply mindshop --remote",
    "typecheck": "npm run build:server && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@aws-sdk/client-s3": "^3.1171.0",
    "@aws-sdk/lib-storage": "^3.1171.0",
    "@hono/node-server": "^2.1.9",
    "@tanstack/react-query": "^5.62.0",
    "antd": "^6.7.1",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.2.12",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.7.0",
    "i18next": "^27.1.5",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^18.0.2",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261117.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "drizzle-kit": "^0.31.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "wrangler": "^4.0.0"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261117.1": true
  }
}
